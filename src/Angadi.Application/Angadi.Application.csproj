<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Angadi.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Angadi.Domain\Angadi.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <!-- Telugu/English strings and voice rules: data, never code (ADR-5).
         WithCulture="false": without it MSBuild reads "strings.te.json" as a Telugu-culture resource and moves it
         into a satellite assembly, so GetManifestResourceStream can't find it (found by the first CI test run). -->
    <EmbeddedResource Include="Resources\*.json" LogicalName="Angadi.Resources.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Resources\voice\*.json" LogicalName="Angadi.Resources.voice.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Angadi.Tests" />
  </ItemGroup>
</Project>
