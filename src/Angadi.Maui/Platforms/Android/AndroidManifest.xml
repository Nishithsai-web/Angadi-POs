<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- minSdk 28 (Android 9) comes from <SupportedOSPlatformVersion>28.0 in Angadi.Maui.csproj.
       targetSdk is pinned: Google Play requires API 36 (Android 16) for new apps and updates from 31 Aug 2026.
       CI fails the build if the APK's targetSdk is ever lower (tools/play_policy_check.py). -->
  <uses-sdk android:targetSdkVersion="36" />

  <!-- Why each permission is needed: docs/PLATFORM_NOTES.md -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="com.android.vending.BILLING" />
  <!-- v2 receipt printing: classic Bluetooth to an ALREADY PAIRED printer only — no discovery, so no BLUETOOTH_SCAN
       and no location. Android 12+: BLUETOOTH_CONNECT (runtime, asked only when the owner sets up the printer).
       Android 9-11: the legacy install-time pair, capped at API 30. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Scanning is optional: manual barcode entry (FR-09) works on camera-less tablets. -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <!-- Printing is optional: phones without Bluetooth still install and bill (receipts go on WhatsApp). -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

  <!-- Android 11+ package visibility: what Angadi must be able to see or launch. -->
  <queries>
    <!-- Google speech recognizer (SpeechRecognizer.IsRecognitionAvailable returns false without this). -->
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
    <!-- WhatsApp and WhatsApp Business (wa.me links, receipt share). -->
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
    <!-- OS share sheet for the receipt PDF and backups. -->
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="*/*" />
    </intent>
    <!-- SMS app (dues reminders for customers without WhatsApp). -->
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="smsto" />
    </intent>
    <!-- UPI apps (upi://pay intent links). -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="upi" />
    </intent>
    <!-- https links (wa.me fallback to browser). -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <!-- Auto Backup to the owner's Google account: only the database and preferences (rules in Resources/xml). -->
  <application
      android:allowBackup="true"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:supportsRtl="true">
  </application>
</manifest>
