<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Angadi.Maui</RootNamespace>
    <ApplicationTitle>అంగడి</ApplicationTitle>
    <ApplicationId>com.angadi.pos</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <!-- Compiled bindings everywhere: every page and template declares x:DataType. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <!-- FIX(RELEASE-1, 2026-10-20, FIX-5): pin trimming explicitly for Release. The TrimmerRootAssembly
         group below only means something with trimming on; before this pin the SDK default decided what
         ships on low-RAM shop tablets. RunAOTCompilation is deliberately NOT pinned (stays off): the app
         is reflection-heavy (sqlite-net, JSON) and AOT is untested — revisit with device perf data.
         Logged in docs/AGENT_FIX_LOG.md. -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <!-- The MAUI head pins its own versions: Microsoft.Maui.Controls must follow the installed workload ($(MauiVersion)),
         which central package management can't express. Core projects stay on Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Release safety: our assemblies and sqlite-net build rows and JSON by reflection; the trimmer must keep them whole. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="Angadi.Domain" />
    <TrimmerRootAssembly Include="Angadi.Application" />
    <TrimmerRootAssembly Include="Angadi.Infrastructure" />
    <TrimmerRootAssembly Include="SQLite-net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Angadi.Application\Angadi.Application.csproj" />
    <ProjectReference Include="..\Angadi.Infrastructure\Angadi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Camera scanning (on-device ML Kit) and Google Play Billing. CommunityToolkit.Maui stays out. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="BarcodeScanning.Native.Maui" Version="2.2.1" />
    <PackageReference Include="Plugin.InAppBilling" Version="8.0.5" />
    <!-- ML Kit pulls androidx.tracing-ktx 1.2 while MAUI pulls tracing 1.3, which absorbed the ktx classes:
         D8 then sees androidx.tracing.TraceKt twice. Lifting ktx to 1.3 (an empty shim) removes the duplicate. -->
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F5132" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F5132" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
