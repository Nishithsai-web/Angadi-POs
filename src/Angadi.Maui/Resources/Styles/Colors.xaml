<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
  Angadi palette (docs/UI_CONVENTIONS.md). Light, high-contrast theme for sunlit counters.
  Every text/background pair below is >= 4.5:1 (WCAG AA); most are >= 7:1.
  Pages use these keys only — never literal colours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand: deep green primary (9.4:1 with white). -->
    <Color x:Key="Primary">#0F5132</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimarySoft">#DDEFE4</Color>

    <!-- Surfaces and text. -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Background">#F4F3EE</Color>
    <Color x:Key="TextPrimary">#101814</Color>
    <Color x:Key="TextSecondary">#44504A</Color>
    <Color x:Key="Border">#8A948E</Color>

    <!-- Status. Warning is the saffron accent (white text 5.0:1). -->
    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="Success">#146C2E</Color>
    <Color x:Key="Warning">#B45309</Color>

    <!-- Tenders: three clearly different hues, all with white text >= 6:1. -->
    <Color x:Key="CashColor">#146C2E</Color>
    <Color x:Key="UpiColor">#3B2A8C</Color>
    <Color x:Key="UdhaarColor">#9A4A00</Color>

</ResourceDictionary>
