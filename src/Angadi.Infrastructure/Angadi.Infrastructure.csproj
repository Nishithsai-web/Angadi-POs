<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral: SQLite, outbox, logging, receipt PDF. Android-only adapters live in Angadi.Maui. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Angadi.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Angadi.Application\Angadi.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <!-- DEPS-1: direct pin — overrides the bundle's transitive lib.e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q,
         NU1903 warning-as-error) with the patched native build 2.1.12. See Directory.Packages.props. -->
    <!-- FIX(BUILD-3, 2026-10-22, Claude Code): Flaw: this pin flowed into the Android app, whose RID fallback took the
         desktop linux-x64 libe_sqlite3.so (needs glibc libc.so.6) instead of the Android one: DllNotFoundException
         e_sqlite3 at startup, the app could not open its database on any phone. Fix: PrivateAssets=all keeps the
         patched desktop lib for this project's own restore (tests also reference it); the app pins
         SQLitePCLRaw.lib.e_sqlite3.android 2.1.12 itself. CI now fails if the APK's libe_sqlite3.so needs glibc.
         Why: the database is the app. Logged in docs/AGENT_FIX_LOG.md. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" PrivateAssets="all" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Seed\*.json" LogicalName="Angadi.Seed.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Angadi.Tests" />
  </ItemGroup>
</Project>
